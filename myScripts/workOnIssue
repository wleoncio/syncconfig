#!/bin/bash
# Starts working on a GitHub issue

script_dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
source "$script_dir/uio-colors.sh"

issue_number=$1

# Checking if issue branch already exists
if [[ $(git branch | grep issue-"$issue_number") ]]; then
	echo "Branch already exists. Switching and rebasing"
	bash resumeWorkOnIssue.sh "$issue_number"
	exit 0
fi	

echo -e "${bold}${blaa}## Self-assigning issue on GitHub${reset}"
echo ""
gh issue edit "$issue_number" --add-assignee @me


echo ""
echo -e "${bold}${blaa}## Creating and checking out branch${reset}"
echo ""
git checkout -b issue-"$issue_number"

# Checking if the project is an R package
if [[ -f "DESCRIPTION" ]]; then
	is_pack="true"
else
	is_pack="false"
fi

if [[ $is_pack = "true" ]]; then
	echo ""
	echo -e "${bold}${blaa}## Package coverage at checkout${reset}"
	echo ""
	Rscript -e "covr::percent_coverage(covr::package_coverage())"
fi

echo ""
echo -e "${bold}${blaa}## Summary of issue${reset}"
echo ""
gh issue view "$issue_number"
